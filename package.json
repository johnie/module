{
    "name": "module",
    "version": "0.0.1",
    "description": "A boilerplate for creating a module",
    "main": "dist/index.cjs",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./math": {
            "import": {
                "types": "./dist/math/index.d.mts",
                "default": "./dist/math/index.mjs"
            },
            "require": {
                "types": "./dist/math/index.d.cts",
                "default": "./dist/math/index.cjs"
            }
        }
    },
    "typings": "dist/index.d.mts",
    "typesVersions": {
        "*": {
            "math": [
                "dist/math/index.d.mts"
            ]
        }
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "scripts": {
        "build": "tsdown",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "biome format --write ./src",
        "check-format": "biome check --write ./src",
        "check-exports": "attw --pack .",
        "local-release": "$npm_execpath run build && $npm_execpath run check-format && $npm_execpath run check-exports && $npm_execpath run test && changeset version && changeset publish",
        "release": "$npm_execpath run build && $npm_execpath run check-format && $npm_execpath run check-exports && $npm_execpath run test && changeset publish"
    },
    "keywords": [
        "module"
    ],
    "author": "Johnie Hjelm <johnie@hjelm.im>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/johnie/module.git"
    },
    "bugs": {
        "url": "https://github.com/johnie/module/issues"
    },
    "homepage": "https://github.com/johnie/module#readme",
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.2",
        "@biomejs/biome": "^2.4.10",
        "@changesets/changelog-github": "^0.6.0",
        "@changesets/cli": "^2.30.0",
        "@types/node": "^25.5.2",
        "tsdown": "^0.21.7",
        "typescript": "^6.0.2",
        "vite": "^8.0.7",
        "vitest": "^4.1.3"
    }
}
